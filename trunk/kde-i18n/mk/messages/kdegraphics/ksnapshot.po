#: main.cpp:9
msgid "KDE Screenshot utility"
msgstr "KDE алатка за сликање на екранот"

#: main.cpp:13
msgid "KSnapshot"
msgstr ""

#: ksnapshot.cpp:44
msgid "snapshot"
msgstr "снимка"

#: ksnapshot.cpp:130
msgid ""
"<qt><center><h1>KSnapshot</h1><p>Press the `Grab' button, the window under "
"the mouse cursor will be grabbed after the specified delay.</P><p><font "
"size=3>KSnapshot is copyright Richard Moore (rich@kde.org) and is released "
"under the LGPL license.</font></p><p><small>Version: "
"%1</small></p></center></qt>"
msgstr ""
"<qt><center><h1>KSnapshot</h1><p>Притиснете го `Фати' копчето, прозорот под "
"покажувачот на глувчето ќе биде фатен после мала пауза.</P><p><font "
"size=3>Авторско право на KSnapshot има Richard Moore (rich@kde.org) и е "
"издадено под LGPL дозвола.</font></p><p><small>Верзија: "
"%1</small></p></center></qt>"

#: ksnapshot.cpp:167
msgid "Filename:"
msgstr "Име на датотека:"

#: ksnapshot.cpp:194
msgid "Delay:"
msgstr "Пауза:"

#: ksnapshot.cpp:203
msgid "seconds."
msgstr "секунди."

#: ksnapshot.cpp:212
msgid "Repeat:"
msgstr "Повторувај:"

#: ksnapshot.cpp:222
msgid "times."
msgstr "пати."

#: ksnapshot.cpp:243
msgid "Auto raise"
msgstr "Автоматско кревање"

#: ksnapshot.cpp:244
msgid "Hide KSnapshot window"
msgstr "Скриј го Ksnapshot прозорот"

#: ksnapshot.cpp:246
msgid "Only grab the window containing the pointer"
msgstr "Фати го само прозорот што го содржи покачувачот"

#: ksnapshot.cpp:277
msgid "Grab"
msgstr "Фати"

#: ksnapshot.cpp:344
msgid "Only local files are supported yet."
msgstr "Само локални датотеки се поддржани сеуште."

#: ksnapshot.cpp:503 ksnapshot.cpp:535
msgid "Error: Unable to save image"
msgstr "Грешка: Не може да се зачува сликата"

#: ksnapshot.cpp:504
msgid "Dismiss"
msgstr "Откажи"

#: ksnapshot.cpp:506
msgid "Warning: This will overwrite an existing file"
msgstr "Предупредување: Ова ќе ја пребрише постоечката слика"

#: ksnapshot.cpp:507
msgid ""
"Are you sure you want to overwrite the existing file named\n"
"%1?"
msgstr ""
"Дали сте сигурни дека сакате да ја пребришете постоечката слика со име\n"
"%1?"

#: ksnapshot.cpp:508
msgid "Overwrite"
msgstr "Пребриши"

#: ksnapshot.cpp:511 ksnapshot.cpp:536
#, c-format
msgid ""
"KSnapshot was unable to save the image to\n"
"%1."
msgstr ""
"KSnapshot не успеа да ја зачува сликата на\n"
"%1."

#: ksnapshot.cpp:551
msgid "KSnapshot preview"
msgstr "KSnapshot преглед"
