msgstr "<qt>Дали навистина сакате да ја запишете врз <b>%1</b>?</qt>"

#: ksnapshot.cpp:198
msgid "Unable to save image"
msgstr "Не можам да ја зачувам сликата"

#: ksnapshot.cpp:199
