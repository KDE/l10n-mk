#. i18n: file cssconfig.ui line 479
#: rc.cpp:104
#, no-c-format
msgid "&Preview"
msgstr "&Преглед"

#. i18n: file cssconfig.ui line 482
#: rc.cpp:107
#, no-c-format
msgid ""
"<b>Preview</b><p>Click on this button to see what your selections look like "
"in action.</p>"
msgstr ""
"<b>Преглед</b><p>Кликнете на ова копче за да видите како изгледа во акција "
"вашиот избор.</p>"

#. i18n: file cssconfig.ui line 529
#: rc.cpp:110
#, no-c-format
msgid "Font Family"
