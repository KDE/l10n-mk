#: legacyimport.cpp:24
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes fr"
"om other platforms in your new KDE desktop. The most common type of legacy th"
"eme is for the GTK toolkit, which is imported to KDE's Control Center with th"
"is utility.<P>In order to do this you must specify at least one item: the fol"
"der where the pixmaps for the theme is located. You may also have to specify "
"the  theme's gtkrc file if it's not in the same folder as the pixmaps. Both a"
"re usually in the folder \"gtk\" inside the theme's directory.</QT>"
msgstr ""
"<QT><b>Увоз на дополнителни теми</b><P>КДЕ подд"
"ржува користење теми од други платформи в"
"о вашиот работен простор. Највообичаениот"
" вид дополнителни теми е оној за GNOME, и тој "
"може да се увезе во КДЕ контролниот центар"
" со помош на оваа алатка.<P>За да го направи"
"те тоа, мора да наведете барем една работа:"
" мапата каде што сликичките за темит се ло"
"цирани. Исто така, може да морате да ја нав"
"едете и gtkrc датотеката на темата. ако не е в"
"о истата таа папка. И двете се, вообичаено, "
"во папката \"gtk\" внатре папката на самата т"
"ема.</QT>"

#: legacyimport.cpp:34
msgid "Step 1: Specify theme's pixmap folder:"
msgstr ""
"Чекор 1: Наведете ја папката со сликички за"
" темата:"

#: legacyimport.cpp:37 legacyimport.cpp:63
msgid "Browse"
msgstr "Разгледај"

#: legacyimport.cpp:52
msgid "Specify pixmap directory"
msgstr "Наведете ја папката со сликички"

#: legacyimport.cpp:56
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the specifie"
"d directory. If it exists somewhere other than where the pixmaps are located "
"enter it here.</QT>"
msgstr ""
"<QT><b>Увоз на дополнителни теми</b><P>gtkrc датот"
"ека не е најдена во наведената папка. Ако т"
"аа постои на некое друго место, наведете г"
"о тоа тука.</QT>"

#: legacyimport.cpp:60
msgid "Step 2: Specify theme's gtkrc:"
msgstr ""
"Чекор 2: Наведете ја датотеката gtkrc на тема"
"та:"

#: legacyimport.cpp:77
msgid "Specify gtkrc directory"
msgstr "Наведете ја папката во која се наоѓа gtkrc"

#: legacyimport.cpp:86
msgid "Legacy Import"
msgstr "Дополнителен увоз"

#: legacyimport.cpp:94
msgid "GTK theme's folder"
msgstr "Папка на GTK тема"

#: legacyimport.cpp:118 legacyimport.cpp:139
msgid "You did not enter a valid file!"
msgstr "Не внесовте валидна датотека!"

#: legacyimport.cpp:126
msgid "Gtkrc theme file"
msgstr "Gtkrc датотека за тема"

#: legacyimport.cpp:146
msgid "Theme title"
msgstr "Наслов на тема"

#: legacyimport.cpp:147
msgid "Please enter a short title for this theme"
msgstr "Внесете краток наслов за оваа тема"

#: legacyimport.cpp:155
msgid "Legacy widget theme"
msgstr "Дополнителна тема на елементи"

#: legacyimport.cpp:161
msgid "The theme is now installed and will be shown in KDE's control center."
msgstr ""
"Темата е инсталирана и ќе биде прикажана в"
"о КДЕ контролниот центар."

#: legacyimport.cpp:168
msgid "KLegacyImport"
msgstr "KLegacyImport"

#: legacyimport.cpp:169
msgid "Importer for legacy themes"
msgstr "Увоз на дополнителни теми"
