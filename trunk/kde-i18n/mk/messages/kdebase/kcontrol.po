#: aboutwidget.cpp:40 main.cpp:92
msgid "KDE Control Center"
msgstr "КДЕ контролен центар"

#: aboutwidget.cpp:42
msgid "Configure your desktop environment."
msgstr "Конфигурирање на работната околина."

#: aboutwidget.cpp:44
msgid ""
"Welcome to the \"KDE Control Center\", a central place to configure your "
"desktop environment. Select an item from the index on the left to load a "
"configuration module."
msgstr ""
"Добродојдовте во \"КДЕ контролниот "
"центар\", средишно место за конфигурирање "
"на вашата работна околина. Изберете "
"елемент од индексот на левата страна за "
"да вчитате конфигурационен модул."

