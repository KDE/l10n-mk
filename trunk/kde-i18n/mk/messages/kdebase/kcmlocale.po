#: localetime.cpp:243
msgid ""
"<p>The text in this textbox will be used to format time strings. The sequence"
"s below will be replaced:</p><table><tr><td><b>%H</b></td><td>The hour as a d"
"ecimal number using a 24-hour clock (00-23).</td></tr><tr><td><b>%k</b></td><"
"td>The hour (24-hour clock) as a decimal number (0-23).</td></tr><tr><td><b>%"
"I</b></td><td>The hour as a decimal number using a 12-hour clock (01-12).</td"
"></tr><tr><td><b>%l</b></td><td>The hour (12-hour clock) as a decimal number "
"(1-12).</td></tr><tr><td><b>%M</b></td><td>The minute as a decimal number (00"
"-59).</td><tr><tr><td><b>%S</b></td><td>The second as a decimal number (00-59"
").</td></tr><tr><td><b>%p</b></td><td>Either \"am\" or \"pm\" according to th"
"e given time value. Noon is treated as \"pm\" and midnight as \"am\".</td></t"
"r></table>"
msgstr ""
"<p>Текстот во овој внес ќе се користи за фор"
"матирање на исписите за времето. Долните и"
"списи ќе бидат заменети:</p><table><tr><td><b>%H</b></td>"
"<td>Часот како број од 00 до 23.</td></tr><tr><td><b>%k</b><"
"/td><td>Часот како број од 0 до 23.</td></tr><tr><td><b>%I</"
"b></td><td>Часот како број од 01 до 12.</td></tr><tr><td><b>"
"%l</b></td><td>Часот како број од 1 до 12.</td></tr><tr><td>"
"<b>%M</b></td><td> Минутите како број од 00 до 59.</td></"
"tr><tr><td><b>%S</b></td><td> Секундите како број од 00 д"
"о 59.</td></tr><tr><td><b>%p</b></td><td> AM и PM. Напладне е PM, "
"а на полноќ е AM.</td></tr></table>"

#: localetime.cpp:266
msgid ""
"<table><tr><td><b>%Y</b></td><td>The year with century as a decimal number.</"
"td></tr><tr><td><b>%y</b></td><td>The year without century as a decimal numbe"
"r (00-99).</td></tr><tr><td><b>%m</b></td><td>The month as a decimal number ("
"01-12).</td></tr><tr><td><b>%n</b></td><td>The month as a decimal number (1-1"
"2).</td></tr><tr><td><b>%b</b></td><td>The first three characters of the mont"
"h name. </td></tr><tr><td><b>%B</b></td><td>The full month name.</td></tr><tr"
"><td><b>%d</b></td><td>The day of month as a decimal number (01-31).</td></tr"
"><tr><td><b>%e</b></td><td>The day of month as a decimal number (1-31).</td><"
"/tr><tr><td><b>%a</b></td><td>The first three characters of the weekday name."
"</td></tr><tr><td><b>%A</b></td><td>The full weekday name.</td></tr></table>"
msgstr ""
"<table><tr><td><b>%Y</b></td><td>Годината со векот како б"
"рој.</td></tr><tr><td><b>%y</b></td><td>Годината без векот"
" како број (00-99).</td></tr><tr><td><b>%m</b></td><td>Месецот"
" како број (01-12).</td></tr><tr><td><b>%n</b></td><td>Месецот"
" како број (1-12).</td></tr><tr><td><b>%b</b></td><td>Скратен"
"ото име на месецот.</td></tr><tr><td><b>%B</b></td><td>Цел"
"осното име на месецот.</td></tr><tr><td><b>%d</b></td><td>"
"Денот од месецот како број (01-31).</td></tr><tr><td><b"
">%e</b></td><td>Денот од месецот како број (1-31).</td>"
"</tr><tr><td><b>%a</b></td><td>Скратеното име на денот в"
"о неделата.</td></tr><tr><td><b>%A</b></td><td>Целосното и"
"ме на денот во неделата.</td></tr></table>"

