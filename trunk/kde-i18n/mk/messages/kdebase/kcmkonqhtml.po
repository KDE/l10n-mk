#: htmlopts.cpp:454
msgid "Global Settings"
msgstr ""

#: htmlopts.cpp:456
#, fuzzy
msgid "Enable &Java globally"
msgstr "Овозможи Java"

#: htmlopts.cpp:457
#, fuzzy
msgid ""
"Enables the execution of scripts written in Java that can be contained in "
"HTML pages. Be aware that Java support is not yet finished. Note that, as "
"with any browser, enabling active contents can be a security problem."
msgstr ""
"Овозможува изведување скрипти напишани "
"во ECMA-Script (познат како JavaScript) што може да "
"се наоѓаат во HTML страни. Забележете дека, "
"како кај секој разгледувач, "
"овозможувањето на скрипт-јазици може да "
"биде сигурносен проблем."

#: htmlopts.cpp:463
#, fuzzy
msgid "Enable Java&Script globally"
msgstr "Овозможи JavaScript"

#: htmlopts.cpp:465
msgid ""
"Enables the execution of scripts written in ECMA-Script (as known as "
"JavaScript) that can be contained in HTML pages. Be aware that JavaScript "
"support is not yet finished. Note that, as with any browser, enabling "
"scripting languages can be a security problem."
msgstr ""
"Овозможува изведување скрипти напишани "
"во ECMA-Script (познат како JavaScript) што може да "
"се наоѓаат во HTML страни. Забележете дека, "
"како кај секој разгледувач, "
"овозможувањето на скрипт-јазици може да "
"биде сигурносен проблем."

