msgstr ""

#: buttontab.cpp:206
msgid ""
"This is a preview of the tile that will be used for window list buttons."
msgstr ""

#: buttontab.cpp:212
msgid "Desktop Access Tiles"
msgstr ""

#: buttontab.cpp:228
msgid "Enable or disable the usage of tile images for desktop access buttons."
msgstr ""

#: buttontab.cpp:229
