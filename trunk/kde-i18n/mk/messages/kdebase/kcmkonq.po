msgstr ""

#: rootopts.cpp:208
msgid "Application Menu"
msgstr ""

#: rootopts.cpp:335
msgid ""
"<h1>Root window options</h1> The \"root window\" is just another name for "
"the desktop. This module allows you to choose various options for your "
"desktop, including the way in which icons are arranged, the location of your "
"desktop directory, and the pop-up menus associated with clicks of the middle "
"and right mouse buttons on the desktop. Use the \"Whats This?\" (Shift+F1) "
"to get help on specific options."
msgstr ""

#: main.cpp:59
msgid "&Behavior"
msgstr ""

