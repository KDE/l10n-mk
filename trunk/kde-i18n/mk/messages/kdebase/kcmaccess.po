msgstr "Кори&сти лепливи тастери"

#: kcmaccess.cpp:195
msgid "&Lock sticky keys"
msgstr "&Заклучи лепливи тастери"

#: kcmaccess.cpp:198
msgid "Slo&w Keys"
msgstr "Ба&вни тастери"

#: kcmaccess.cpp:204
msgid "&Use slow keys"
msgstr "К&ористи бавни тастери"

#: kcmaccess.cpp:212
msgid "Dela&y:"
msgstr "Па&уза:"

#: kcmaccess.cpp:216
msgid "Bounce Keys"
msgstr "Отскочни тастери"

#: kcmaccess.cpp:222
msgid "Use bou&nce keys"
msgstr "Користи отскоч&ни тастери"

#: kcmaccess.cpp:230
msgid "D&elay:"
msgstr "П&ауза:"

#: kcmaccess.cpp:247
msgid "&Keyboard"
msgstr "&Тастатура"

