msgid "Sticky Keys"
msgstr "Лепливи копчиња"

#: kcmaccess.cpp:162
msgid "Use &sticky keys"
msgstr "Користење на лепливи копчиња"

#: kcmaccess.cpp:167
msgid "&Lock sticky keys"
msgstr "Заклучи ги лепливите копчиња"

#: kcmaccess.cpp:170
msgid "Slow Keys"
msgstr "Бавни копчиња"

#: kcmaccess.cpp:176
msgid "Use s&low keys"
msgstr "Користење на бавни копчиња"

#: kcmaccess.cpp:184 kcmaccess.cpp:202
msgid "Delay:"
msgstr "Пауза:"

#: kcmaccess.cpp:188
msgid "Bounce Keys"
msgstr "Отскочни копчиња"

#: kcmaccess.cpp:194
msgid "Use &bounce keys"
msgstr "Користење на отскочни копчиња"

#: kcmaccess.cpp:219
msgid "&Keyboard"
msgstr "Тастатура"

#: kcmaccess.cpp:230
msgid "Mouse navigation"
msgstr "Движење на глушецот"

#: kcmaccess.cpp:236
msgid "&Move mouse with keyboard (using the Num pad)"
msgstr "Движење на глушецот со тастатура (со Num pad)"

#: kcmaccess.cpp:242
msgid "&Acceleration delay"
msgstr "Пауза при забрзување"

#: kcmaccess.cpp:250
msgid "&Repeat interval"
msgstr "Интервал на повторување"

#: kcmaccess.cpp:258
msgid "Acceleration &time"
msgstr "Време на забрзување"

#: kcmaccess.cpp:265
msgid "&Maximum speed"
msgstr "Максимална брзина"

#: kcmaccess.cpp:272
msgid "Acceleration &profile"
msgstr "Профил на забрзување"

#: kcmaccess.cpp:286
