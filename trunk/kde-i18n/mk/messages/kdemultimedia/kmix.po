#: mixer.cpp:185
msgid ""
"kmix:You have no permission to access the mixer device.\n"
"Please check your operating systems manual to allow the access."
msgstr ""
"kmix:Немате дозвола за пристап на миксер уредот.\n"
"Проверете го упатството за вашиот оперативен систем за овозможување пристап."

#: mixer.cpp:189
msgid "kmix: Could not write to mixer."
msgstr "kmix: Не може да се пишува во миксерот."

#: mixer.cpp:192
msgid "kmix: Could not read from mixer."
msgstr "kmix: Не може да се чита од миксерот."

#: mixer.cpp:195
msgid "kmix: Your mixer does not control any devices."
msgstr "kmix: Вашиот миксер не контролира ниеден уред"

#: mixer.cpp:198
msgid ""
"kmix: Mixer does not support your platform. See mixer.cpp for porting hints "
"(PORTING)."
msgstr ""
"kmix: Миксерот не ја поддржува вашата платформа. Погледнете го mixer.cpp за "
"некои детали околу пренесувањето (PORTING)."

#: mixer.cpp:201
msgid "kmix: Not enough memory."
msgstr "kmix: Недоволно меморија"

#: mixer.cpp:204
msgid ""
"kmix: Mixer cannot be found.\n"
"Please check that the soundcard is installed and the\n"
"soundcard driver is loaded\n"
msgstr ""
"kmix: Миксерот не може да се пронајде.\n"
"Осигурајте се дека звучната картичка е инсталирана\n"
"и вчитан е драјверот за звук\n"

#: mixer.cpp:209
msgid ""
"kmix: Initial set is incompatible.\n"
"Using a default set.\n"
msgstr ""
"kmix: Почетните поставки се некомпатибилни.\n"
"Се користат стандардните.\n"

#: mixer.cpp:213
msgid "kmix: Unknown error. Please report, how you produced this error."
msgstr "kmix: Непозната грешка. Ве молиме пријавете како ја создадовте."

