msgstr "Користење на меморија"

#: part/katedialogs.cpp:838
msgid "Automatic Cleanups on Save"
msgstr "Автоматски чистења при зачувување"

#: part/katedialogs.cpp:841
msgid "Replace &tabs with spaces"
msgstr "Замена на &табулатори со растојанија"

#: part/katedialogs.cpp:844
