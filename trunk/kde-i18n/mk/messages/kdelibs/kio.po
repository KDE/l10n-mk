msgstr "Тип на клуч: RSA (%1 бита)"

#: kssl/ksslcertificate.cc:321
msgid "Modulus: "
msgstr "Остаток:"

#: kssl/ksslcertificate.cc:334
msgid "Exponent: 0x"
msgstr "Експонент: 0x"

#: kssl/ksslcertificate.cc:340
msgid "Key type: DSA (%1 bit)"
msgstr "Тип на клуч: DSA (%1 бита)"

