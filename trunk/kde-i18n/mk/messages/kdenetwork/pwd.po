#: pwswidget.cpp:82
msgid "Save Configuration"
msgstr "Зачувај Конфигурација"

#: pwswidget.cpp:84
msgid "(Re)Start Server"
msgstr "(Ре)Стартирај Сервер"

#: pwswidget.cpp:86
msgid "Log Window"
msgstr "Лог Прозорец"

#: pwswidget.cpp:88
msgid "Delete Server"
msgstr "Избриши Сервер"

#: pwswidget.cpp:90
msgid "Add Server"
msgstr "Додади Сервер"

#: kfileio.cpp:25
msgid "File I/O Error"
msgstr "В/И Грешка на Датотека"

#: kfileio.cpp:26
msgid "Ok"
msgstr "Во Ред"

#: kfileio.cpp:45
#, c-format
msgid ""
"The specified file does not exist:\n"
"%s"
msgstr ""
"Избраната датотека не постои:\n"
"%s"

#: kfileio.cpp:52
#, c-format
msgid ""
"This is a directory and not a file:\n"
"%s"
msgstr ""
"Ова е папка а не датотека:\n"
"%s"

#: kfileio.cpp:59
#, c-format
msgid ""
"You do not have read permissions to the file:\n"
"%s"
msgstr ""
"Немате дозвола за читање од датотеката:\n"
"%s"

#: kfileio.cpp:70
#, c-format
msgid ""
"Could not read file:\n"
"%s"
msgstr ""
"Неможе да се чита датотеката:\n"
"%s"

#: kfileio.cpp:73
#, c-format
msgid ""
"Could not open file:\n"
"%s"
msgstr ""
"Неможе да се отвори датотеката:\n"
"%s"

#: kfileio.cpp:76
#, c-format
msgid ""
"Error while reading file:\n"
"%s"
msgstr ""
"Грешка при читање на датотеката:\n"
"%s"

#: kfileio.cpp:93
#, c-format
msgid "Could only read %u bytes of %u."
msgstr "Можеа да се прочитаат само %u бајти од %u."

#: kfileio.cpp:122
#, c-format
msgid ""
"File %s exists.\n"
"Do you want to replace it ?"
msgstr ""
"Датотеката %s постои.\n"
"Дали сакате да ја замените ?"

#: kfileio.cpp:125 kfileio.cpp:143
msgid "&Ok"
msgstr "Во Ред"

#: kfileio.cpp:142
#, c-format
msgid ""
"Failed to make a backup copy of %s.\n"
"Continue anyway ?"
msgstr ""
"Неуспеа да се направи бекап копија од %s.\n"
"Продолжете секако ?"

#: kfileio.cpp:154 kfileio.cpp:172
#, c-format
msgid ""
"Could not write to file:\n"
"%s"
msgstr ""
"Неможе да се пишува во датотеката:\n"
"%s"

#: kfileio.cpp:157
#, c-format
msgid ""
"Could not open file for writing:\n"
"%s"
msgstr ""
"Неможе да се отвори датотеката за запишување:\n"
"%s"

#: kfileio.cpp:161
#, c-format
msgid ""
"Error while writing file:\n"
"%s"
msgstr ""
"Грешки при запишување во датотеката:\n"
"%s"

#: kfileio.cpp:178
#, c-format
msgid "Could only write %d bytes of %d."
msgstr "Може да се запишат само %d бајти од %d."

#: addwizard.cpp:41
msgid "Server Name"
msgstr "Име на Серверот"

#: addwizard.cpp:45
msgid "Server's Public Directory"
msgstr "Јавна Папка на Серверот"

#: addwizard.cpp:49
msgid "Server's Port Number"
msgstr "Број на Порта на Серверот"

#: addwizard.cpp:53
msgid "Finish"
msgstr "Завршено"

#: addwizard.cpp:86
msgid ""
"Enter a name for this server.\n"
"This name is used to identify\n"
"this configuration."
msgstr ""
"Внесете име за овој сервер.\n"
"Ова име се користи да ја идентификува\n"
"оваа конфигурација."

#: addwizard.cpp:93
msgid "Name:"
msgstr "Име:"

#: addwizard.cpp:97
msgid "MyServer"
msgstr "МојСервер"

#: addwizard.cpp:123 addwizard.cpp:136 addwizard.cpp:196
msgid "PWS: Error"
msgstr "PWS: Грешка"

#: addwizard.cpp:124
msgid ""
"Nothing is not a name.\n"
"Please choose one"
msgstr ""
"Ништо не е име.\n"
"Ве молам изберете име"

#: addwizard.cpp:137
msgid ""
"That server name already exists.\n"
"Please choose a new one"
msgstr ""
"Тоа име веќе постои.\n"
"Ве молам изберете ново име"

#: addwizard.cpp:155
msgid ""
"Enter the name of the directory where\n"
"the web pages are located.\n"
msgstr ""
"Внесете го името на папката каде\n"
"веб страниците се лоцирани.\n"

#: addwizard.cpp:161
msgid "Directory:"
msgstr "Папка:"

#: addwizard.cpp:197
msgid ""
"That directory doesn't exist.\n"
"Do you want me to create it?"
msgstr ""
"Таа папка не постои.\n"
"Дали сакате да се создаде?"

#: addwizard.cpp:228
msgid ""
"Enter a port for this server.\n"
"The port is part of the URL for the server\n"
"for example, in http://my.server.org:800\n"
"800 is the port number.\n"
"The standard port for web servers is 80\n"
"To use a port number under 1024 you will \n"
"need the root password."
msgstr ""
"Внесете порта за овој сервер.\n"
"Портата е дел од URL за серверот\n"
"на пример, во http://moj.server.org:800\n"
"800 е дел од бројот на портата.\n"
"Стандардната порта за веб сервери е 80\n"
"За да користите број помал од 1024 треба\n"
"да имате root шифра."

#: addwizard.cpp:240
msgid "Port Number:"
msgstr "Број на Порта:"

#: addwizard.cpp:273
msgid ""
"You have finished configuring\n"
"the web server.\n"
"Press Finish to save it, Cancel to\n"
"forget about it.\n"
msgstr ""
"Завршивте со конфигурирањето\n"
"на веб серверот.\n"
"Притиснете Заврши да ја зачувате конф.,\n"
"или Откажи да откажете.\n"
