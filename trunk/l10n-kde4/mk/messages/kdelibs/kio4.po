msgid "Unknown Interruption"
msgstr "Непознато прекинување"

#: kio/global.cpp:1104
#, kde-format
msgid ""
"The program on your computer which provides access to the <strong>%1</"
"strong> protocol has reported an interruption of an unknown type: %2."
msgstr ""
