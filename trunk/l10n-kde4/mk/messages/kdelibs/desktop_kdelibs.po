msgstr "Сервис за текст-во-говор со DCOP-интерфејс"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Вгнезден текст уредувач"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:64
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Сервисот за текст уредувач ги снабдува апликациите со текст прегледник и "
"уредувач. KDE апликациите што овозможуваат уредување текст би требало да го "
"користат овој сервис."

#: interfaces/ktexteditor/ktexteditor.desktop:6
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr ""
"Вгнездлива компонента за уредување на текст (со Док/Приказ раздвојување)"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:6
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "KTextEditor приклучок"

#: kate/data/katepart.desktop:3
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Вгнезден напреден текст уредувач"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:3
msgctxt "Name"
msgid "KTextEditor Autobookmarker"
msgstr "KTextEditor Автообележувач"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:56
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Постава обележувачи на линиите кои се поклопуваат со шема кога документите "
"се вчитуваат"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:3
msgctxt "Name"
msgid "KTextEditor Insert File Plugin"
msgstr "KTextEditor приклучок за внес на датотеки"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:65
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Внесува било која читлива датотека на позицијата на курсорот"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:3
msgctxt "Name"
msgid "KTextEditor KDataTool Plugin"
msgstr "KTextEditor KDataTool приклучок"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:65
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Овозможување на алатки како енциклопедија или проверка на правопис (ако се "
"инсталирани)"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:3
msgctxt "Name"
msgid "KTextEditor Word Completion Plugin"
msgstr "KTextEditor приклучок за довршување на зборови"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:60
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
msgstr "Насочено или скок-базирано довршување од зборови во документот"

