#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Инстант гласник (Messenger) со D-Bus интерфејс"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:1
msgctxt "Name"
msgid "Instant Messenger"
msgstr "Инстант Гласник (Messenger)"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:64
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Инстант гласникот овозможува двонасочна комуникација меѓу индивидуи и групи."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "Сервис за текст-во-говор со D-Bus-интерфејс"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Вгнезден текст уредувач"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:69
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Сервисот за текст уредувач ги снабдува апликациите со текст прегледник и "
"уредувач. KDE апликациите што овозможуваат уредување текст би требало да го "
"користат овој сервис."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr ""
"Вгнездлива компонента за уредување на текст (со Док/Приказ раздвојување)"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "KTextEditor приклучок"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Вгнезден напреден текст уредувач"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Автом. обележувач"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:64
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Постава обележувачи на линиите кои се поклопуваат со шема кога документите "
"се вчитуваат"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Внетнување датотека"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:68
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Внесува било која читлива датотека на позицијата на курсорот"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data tools"
msgstr "Податочни алатки"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:68
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Овозможување на алатки како енциклопедија или проверка на правопис (ако се "
"инсталирани)"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:16
msgctxt "Name"
msgid "Time & Date"
msgstr "Датум и време"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:61
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Ги вметнува тековните датум и време"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:9
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Формат на вметнатите датум и време"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:17
msgctxt "Name"
msgid "Word Completion"
msgstr "Довршување зборови"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:67
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
msgstr "Насочено или скок-базирано довршување од зборови во документот"

