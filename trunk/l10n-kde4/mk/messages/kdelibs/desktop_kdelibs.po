#: kate/plugins/timedate/ktexteditor_timedate.desktop:8
#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:8
msgctxt "X-KDE-PluginInfo-Category"
msgid "Editor"
msgstr ""

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:33
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Автом. обележувач"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:83
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Постава обележувачи на линиите кои се поклопуваат со шема кога документите "
"се вчитуваат"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:34
msgctxt "Name"
msgid "Insert File"
msgstr "Внетнување датотека"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:88
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Внесува било која читлива датотека на позицијата на курсорот"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:34
msgctxt "Name"
msgid "Data tools"
msgstr "Податочни алатки"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:88
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Овозможување на алатки како енциклопедија или проверка на правопис (ако се "
"инсталирани)"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:33
msgctxt "Name"
msgid "Time & Date"
msgstr "Датум и време"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:81
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Ги вметнува тековните датум и време"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:9
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Формат на вметнатите датум и време"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:34
msgctxt "Name"
msgid "Word Completion"
msgstr "Довршување зборови"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:88
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
