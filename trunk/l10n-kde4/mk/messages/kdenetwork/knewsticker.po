#. i18n: file newssourcedlg.ui line 175
#. i18n: tag string
#. i18n: file newssourcedlg.ui line 186
#: rc.cpp:604 rc.cpp:612
#, no-c-format
msgid "Into which category does this news source belong?"
msgstr "Во која категорија припаѓа овој извор на вести?"

