#: kwriteapp.cpp:37 kwritemain.cpp:499
msgid ""
"A KDE text-editor component could not be found.\n"
"Please check your KDE installation."
msgstr ""
"Не е најдена компонента од KDE за уредување на текст\n"
"Проверете ја вашата инсталација на KDE."

#: kwriteapp.cpp:145
#, kde-format
msgid ""
"The file '%1' could not be opened: it is not a normal file, it is a folder."
msgstr ""
"Датотеката „%1“ не можеше да биде отворена: не е обична датотека, туку папка."

#: kwritemain.cpp:149
msgid "Use this command to close the current document"
msgstr "Користете ја наредбава за да го затворите тековниот документ"

#: kwritemain.cpp:153
msgid "Use this command to create a new document"
msgstr "Користете ја командава за да креирате нов документ"

#: kwritemain.cpp:155
msgid "Use this command to open an existing document for editing"
msgstr "Користете ја командава за да отворите постоен документ за уредување"

#: kwritemain.cpp:159
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"Ова е листа на датотеки кои сте ги отвориле неодамна и ви овозможува лесно "
"да ги отворите повторно."

#: kwritemain.cpp:163
msgid "&New Window"
msgstr "&Нов прозорец"

#: kwritemain.cpp:165
msgid "Create another view containing the current document"
msgstr "Креира нов поглед што го содржи тековниот документ"

#: kwritemain.cpp:168
msgid "Close the current document view"
msgstr "Го затвора погледот за тековниот документ"

#: kwritemain.cpp:175
msgid "Use this command to show or hide the view's statusbar"
msgstr ""
"Користете ја оваа команда за да ја прикажете/скриете статусната линија на "
"погледот"

#: kwritemain.cpp:177
msgid "Sho&w Path"
msgstr "При&кажи патека"

#: kwritemain.cpp:180
msgid "Show the complete document path in the window caption"
msgstr "Ја прикажува целата патека на документот во насловот на прозорецот"

#: kwritemain.cpp:183
msgid "Configure the application's keyboard shortcut assignments."
msgstr "Конфигурирајте ги кратенките на тастатурата за апликацијата."

#: kwritemain.cpp:187
msgid "Configure which items should appear in the toolbar(s)."
msgstr "Конфигурирајте кои елементи треба да се појавуваат во алатникот."

#: kwritemain.cpp:190
msgid "&About Editor Component"
msgstr "З&а компонентата за уредување"

#: kwritemain.cpp:199 kwritemain.cpp:561
#, kde-format
msgctxt "@info:status Statusbar label for cursor line and column position"
msgid " Line: %1 Col: %2 "
msgstr " Ред: %1 Кол: %2 "

#: kwritemain.cpp:210
msgid " INS "
msgstr " ВМЕТ "

#: kwritemain.cpp:214 kwritemain.cpp:568
msgctxt "@info:status Statusbar label for line selection mode"
msgid " LINE "
msgstr " РЕД "

#: kwritemain.cpp:272
msgid "Open File"
msgstr "Отворете датотека"

#: kwritemain.cpp:287
msgid ""
"The file given could not be read; check whether it exists or is readable for "
"the current user."
msgstr ""
"Зададената датотека не можеше да биде прочитана. Проверете дали постои или "
"дали е достапна за читање за тековниот корисник."

#: kwritemain.cpp:567
msgctxt "@info:status Statusbar label for block selection mode"
msgid " BLOCK "
msgstr " БЛОК "

