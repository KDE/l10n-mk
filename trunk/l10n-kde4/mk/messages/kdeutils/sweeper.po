#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:36
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Предупреди ме кога посетувам страна која ги користи моите медицински или "
"здравствени информации:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:45
msgid "Demographics"
msgstr "Демографски"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:48
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Предупреди ме кога посетувам страна која ги користи моите информации кои не "
"се лични:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:51
msgid "To determine my interests, habits or general behavior"
msgstr "За да ги определи моите интереси, навики или општо однесување"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Предупреди ме кога посетувам страна која ги користи моите лични информации "
"со други компании"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:60
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Предупреди ме кога посетувам страна која не ми дава на знаење кои информации "
"ги има за мене"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:63
msgid "Personal Information"
msgstr "Лична информација"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Предупреди ме кога посетувам страна која може да контактира со мене за други "
"продукти или сервиси:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Предупреди ме кога посетувам страна која може да ги користи моите лични "
"информации за:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "да ги определи моите навики, интереси или општото однесување"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:75
msgid "Via telephone"
msgstr "По телефон"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:78
msgid "Via mail"
msgstr "по пошта"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "по е-пошта"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "и не ми дозволува да ги отстранам моите информации за контакт"

