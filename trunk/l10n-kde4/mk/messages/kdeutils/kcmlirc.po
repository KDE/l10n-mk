#: kcmlirc.cpp:59
msgid "KDE Lirc"
msgstr "KDE Lirc"

#: kcmlirc.cpp:59
msgid "The KDE IR Remote Control System"
msgstr "Системот за IR далечинско управување во KDE"

#: kcmlirc.cpp:59
msgid "Copyright (c)2003 Gav Wood"
