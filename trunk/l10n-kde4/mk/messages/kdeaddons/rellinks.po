#: plugin_rellinks.cpp:57
msgid "Rellinks"
msgstr "Rellinks"

#: plugin_rellinks.cpp:72
msgid "&Top"
msgstr "&Врв"

#: plugin_rellinks.cpp:75
msgid "<p>This link references a home page or the top of some hierarchy.</p>"
msgstr ""
"<p>Оваа врска упатува на домашната страница или на врвот од некоја "
"хиерархија.</p>"

#: plugin_rellinks.cpp:80
msgid "&Up"
msgstr "&Горе"

#: plugin_rellinks.cpp:83
msgid ""
"<p>This link references the immediate parent of the current document.</p>"
msgstr ""
"<p>Оваа врска упатува на непосредниот родител на тековниот документ.</p>"

#: plugin_rellinks.cpp:90
msgid "&First"
msgstr "П&рв"

#: plugin_rellinks.cpp:93
msgid ""
"<p>This link type tells search engines which document is considered by the "
"author to be the starting point of the collection.</p>"
msgstr ""
"<p>Овој тип на врска им кажува на машините за пребарување кој документ се "
"смета од страна на авторот како почетна точка во колекцијата.</p>"

#: plugin_rellinks.cpp:98
msgid "&Previous"
msgstr ""

#: plugin_rellinks.cpp:102
msgid ""
"<p>This link references the previous document in an ordered series of "
"documents.</p>"
msgstr ""
"<p>Оваа врска упатува на претходниот документ во подредена низа документи.</"
"p>"

#: plugin_rellinks.cpp:106
msgid "&Next"
msgstr "&Следен"

#: plugin_rellinks.cpp:109
msgid ""
"<p>This link references the next document in an ordered series of documents."
"</p>"
msgstr ""
"<p>Оваа врска упатува на следниот документ во подредена низа документи.</p>"

#: plugin_rellinks.cpp:114
msgid "&Last"
msgstr "Пос&леден"

#: plugin_rellinks.cpp:118
msgid "<p>This link references the end of a sequence of documents.</p>"
msgstr "<p>Оваа врска упатува на крајот од низата на документи.</p>"

#: plugin_rellinks.cpp:123
msgid "&Search"
msgstr "&Барај"

#: plugin_rellinks.cpp:126
msgid "<p>This link references the search.</p>"
msgstr "<p>Оваа врска упатува на барањето.</p>"

#: plugin_rellinks.cpp:131
msgid "Document"
msgstr "Документ"

#: plugin_rellinks.cpp:133
msgid "<p>This menu contains the links referring the document information.</p>"
msgstr ""
"<p>Ова мени ги содржи врските што упатуваат на информацијата за документот.</"
"p>"

#: plugin_rellinks.cpp:137
msgid "Table of &Contents"
msgstr "&Содржина"

#: plugin_rellinks.cpp:140
msgid "<p>This link references the table of contents.</p>"
msgstr "<p>Оваа врска упатува на содржината.</p>"

#: plugin_rellinks.cpp:145
msgid "Chapters"
msgstr "Поглавја"

#: plugin_rellinks.cpp:150
msgid "<p>This menu references the chapters of the document.</p>"
msgstr "<p>Ова мени упатува на поглавјата од документот.</p>"

#: plugin_rellinks.cpp:153
msgid "Sections"
msgstr "Секции"

#: plugin_rellinks.cpp:159
msgid "<p>This menu references the sections of the document.</p>"
msgstr "<p>Ова мени упатува на секциите на документот.</p>"

#: plugin_rellinks.cpp:162
msgid "Subsections"
msgstr "Подсекции"

#: plugin_rellinks.cpp:167
msgid "<p>This menu references the subsections of the document.</p>"
msgstr "<p>Ова мени упатува на подсекциите на документот.</p>"

#: plugin_rellinks.cpp:170
msgid "Appendix"
msgstr "Додаток"

#: plugin_rellinks.cpp:175
msgid "<p>This link references the appendix.</p>"
msgstr "<p>Оваа врска упатува на додатокот.</p>"

#: plugin_rellinks.cpp:179
msgid "&Glossary"
msgstr "Р&ечник"

#: plugin_rellinks.cpp:183
msgid "<p>This link references the glossary.</p>"
msgstr "<p>Оваа врска упатува на речникот.</p>"

#: plugin_rellinks.cpp:188
msgid "&Index"
msgstr "&Индекс"

#: plugin_rellinks.cpp:191
msgid "<p>This link references the index.</p>"
msgstr "<p>Оваа врска упатува на индексот.</p>"

#: plugin_rellinks.cpp:197
msgid "More"
msgstr "Повеќе"

#: plugin_rellinks.cpp:199
msgid "<p>This menu contains other important links.</p>"
msgstr "<p>Ова мени содржи други важни врски.</p>"

#: plugin_rellinks.cpp:203
msgid "&Help"
msgstr ""

#: plugin_rellinks.cpp:206
msgid "<p>This link references the help.</p>"
msgstr "<p>Оваа врска упатува на помошта.</p>"

#: plugin_rellinks.cpp:212
msgid "&Authors"
msgstr "&Автори"

#: plugin_rellinks.cpp:215
msgid "<p>This link references the author.</p>"
msgstr "<p>Оваа врска упатува на авторот.</p>"

#: plugin_rellinks.cpp:221
msgid "Copy&right"
msgstr "Автор&ски права"

#: plugin_rellinks.cpp:224
msgid "<p>This link references the copyright.</p>"
msgstr "<p>Оваа врска упатува на авторските права.</p>"

#: plugin_rellinks.cpp:229
msgid "Bookmarks"
msgstr ""

#: plugin_rellinks.cpp:232
msgid "<p>This menu references the bookmarks.</p>"
msgstr "<p>Ова мени упатува на обележувачите.</p>"

#: plugin_rellinks.cpp:236
msgid "Other Versions"
msgstr "Други верзии"

#: plugin_rellinks.cpp:239
msgid "<p>This link references the alternate versions of this document.</p>"
msgstr "<p>Оваа врска упатува на алтернативните верзии на овој документ.</p>"

#: plugin_rellinks.cpp:244
#, fuzzy
msgid "Miscellaneous"
msgstr "<p>Разни врски.</p>"

#: plugin_rellinks.cpp:247
msgid "<p>Miscellaneous links.</p>"
msgstr "<p>Разни врски.</p>"

