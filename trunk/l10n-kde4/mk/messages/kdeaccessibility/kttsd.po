msgid "&Filters"
msgstr "&Филтри"

#: rc.cpp:182
msgid "Click to add and configure a new Filter."
msgstr "Кликнете за додавање и конфигурирање на нов филтер."

#: rc.cpp:188
msgid ""
"Click to move selected filter up in the list.  Filters higher in the list "
