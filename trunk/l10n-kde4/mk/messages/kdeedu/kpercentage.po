#: kpercentage.cpp:75
msgid "Number of tasks:"
msgstr "Број на задачи:"

#: kpercentage.cpp:76
msgid "Level:"
msgstr "Ниво:"

#: kpercentage.cpp:77
msgid "Choose an exercise type:"
msgstr "Избери тип на вежба:"

#: kpercentage.cpp:85
#, no-c-format
msgid "x% &of ?? = y"
msgstr "x% &од ?? = y"

#: kpercentage.cpp:87
#, no-c-format
msgid "x% of &y = ??"
msgstr "x% од &y = ??"

#: kpercentage.cpp:89
#, no-c-format
msgid "??% o&f x = y"
msgstr "??% о&д x = y"

