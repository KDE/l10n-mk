msgstr "Прикажи ја мојата домашна страница"

#: generalopts.cpp:88
msgctxt "@item:inlistbox"
msgid "Show Blank Page"
msgstr "Прикажи празна страница"

#: generalopts.cpp:89
msgctxt "@item:inlistbox"
