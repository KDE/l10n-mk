#: clock.cpp:124
msgctxt "@title:window"
msgid "Configure Clock"
msgstr "Конфигурација на часовникот"

#. i18n: tag string
#. i18n: file clockConfig.ui line 64
#: rc.cpp:3
msgid "Area"
msgstr "Област"

#. i18n: tag string
#. i18n: file clockConfig.ui line 69
#: rc.cpp:6
msgid "Region"
msgstr "Регион"

#. i18n: tag string
#. i18n: file clockConfig.ui line 74
#: rc.cpp:9
msgid "Comment"
msgstr "Коментар"

#. i18n: tag string
#. i18n: file clockConfig.ui line 82
#: rc.cpp:12
msgid "Display the second hand"
msgstr "Прикажи стрелка за секунди"

#. i18n: tag string
#. i18n: file clockConfig.ui line 85
#: rc.cpp:15
msgid ""
"Check this if you want to display the second hand in order to see the "
"seconds."
msgstr "Изберете го ова ако сакате ја прикажете стрелката за секунди."

#. i18n: tag string
#. i18n: file clockConfig.ui line 88
#: rc.cpp:18
msgid "Display seconds"
msgstr "Прикажи секунди"

#. i18n: tag string
#. i18n: file clockConfig.ui line 95
#: rc.cpp:21
msgid "Display the time as a string"
msgstr "Прикажи го времето како низа"

#. i18n: tag string
#. i18n: file clockConfig.ui line 98
#: rc.cpp:24
msgid "Check this if you want to display the time as a string within the clock."
msgstr "Изберете го ова ако сакате да го прикажете времето како низа во рамките на часовникот."

#. i18n: tag string
#. i18n: file clockConfig.ui line 101
#: rc.cpp:27
msgid "Also display the time in text"
msgstr "Прикажи го времето и како текст"

#. i18n: tag string
#. i18n: file clockConfig.ui line 125
#: rc.cpp:30
msgid "Size of the clock:"
msgstr "Големина на часовникот:"

#. i18n: tag string
#. i18n: file clockConfig.ui line 132
#: rc.cpp:33
msgid "Change clock size"
msgstr "Промена на големината на часовникот"

#. i18n: tag string
#. i18n: file clockConfig.ui line 135
#: rc.cpp:36
msgid ""
"Set a new size for the clock between 0 and 500. The size is the square side "
"that contains the clock."
msgstr ""

