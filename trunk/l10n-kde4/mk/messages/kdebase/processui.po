#. i18n: tag string
#. i18n: file ReniceDlgUi.ui line 256
#: rc.cpp:82 rc.cpp:149
msgid "Normal"
msgstr "Нормално"

#. i18n: tag string
#. i18n: file ReniceDlgUi.ui line 122
