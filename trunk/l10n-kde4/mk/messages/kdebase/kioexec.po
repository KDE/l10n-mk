#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - Отвора оддалечени датотеки, набљудува евентуални промени, прашува "
"за качување"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Ги третира URL како локални датотеки и ги брише подоцна"

#: main.cpp:51
msgid "Suggested file name for the downloaded file"
msgstr "Предложено име за симнатата датотека"

#: main.cpp:52
msgid "Command to execute"
msgstr "Команда за извршување"

#: main.cpp:53
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL или локална датотека за „команда“."

#: main.cpp:62
msgid "'command' expected.\n"
msgstr "Се очекуваше „команда“.\n"

#: main.cpp:91
#, qt-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"УРЛ %1\n"
"е неправилен"

#: main.cpp:93
#, qt-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Оддалечениот URL %1\n"
"не е дозволен со опцијата --tempfiles"

#: main.cpp:222
#, qt-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Привремената датотека\n"
"%1\n"
"беше изменета.\n"
"Дали сѐ уште сакате да ја избришете?"

#: main.cpp:223 main.cpp:230
msgid "File Changed"
msgstr "Датотеката е променета"

#: main.cpp:223
msgid "Do Not Delete"
msgstr "Не бриши"

#: main.cpp:229
#, qt-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Датотеката\n"
"%1\n"
"беше променета.\n"
"Дали сакате да ги качите разликите?"

#: main.cpp:230
msgid "Upload"
msgstr "Качи"

#: main.cpp:230
msgid "Do Not Upload"
msgstr "Не качувај"

#: main.cpp:253
msgid "KIOExec"
msgstr "KIOExec"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Божидар Проевски"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "bobibobi@freemail.com.mk"
