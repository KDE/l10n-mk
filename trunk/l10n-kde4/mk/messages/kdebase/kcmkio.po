#: rc.cpp:618 rc.cpp:627
#, fuzzy
#| msgid ""
#| "<qt>\n"
#| "Enter the site or domain name where a fake browser identification should "
#| "be used.<p>\n"
#| "<u>NOTE:</u> Wildcard syntax such as \\\"*,?\\\" is NOT allowed: instead, "
