msgstr ""
"Дали навистина сакате да го активирате „%1“ и да ги деактивирате „%2“, „%3“ "
"и „%4“?"

#: kaccess.cpp:728
#, kde-format
msgid "Do you really want to activate \"%1\" and \"%2\"?"
