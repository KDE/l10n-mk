#: kdialog.cpp:63
msgid "Question message box with yes/no buttons"
msgstr "Порака со прашање со копчиња да/не"

#: kdialog.cpp:64
msgid "Question message box with yes/no/cancel buttons"
msgstr "Порака со прашање со копчиња да/не/откажи"

#: kdialog.cpp:65
msgid "Warning message box with yes/no buttons"
msgstr "Порака со предупредување со копчиња да/не"

#: kdialog.cpp:66
msgid "Warning message box with continue/cancel buttons"
msgstr "Порака со предупредување со копчиња продолжи/откажи"

#: kdialog.cpp:67
msgid "Warning message box with yes/no/cancel buttons"
msgstr "Порака со предупредување со копчиња да/не/откажи"

#: kdialog.cpp:68
msgid "'Sorry' message box"
msgstr "Порака „Жалам“"

#: kdialog.cpp:69
msgid "'Error' message box"
msgstr "Порака „Грешка“"

#: kdialog.cpp:70
msgid "Message Box dialog"
msgstr "Дијалог со порака "

#: kdialog.cpp:71
msgid "Input Box dialog"
msgstr "Дијалог со полиња за внес"

#: kdialog.cpp:72
msgid "Password dialog"
msgstr "Дијалог за лозинка "

#: kdialog.cpp:73
msgid "Text Box dialog"
msgstr "Дијалог со поле за текст"

#: kdialog.cpp:74
#, fuzzy
msgid "Text Input Box dialog"
msgstr "Дијалог со полиња за внес"

#: kdialog.cpp:75
msgid "ComboBox dialog"
msgstr "Дијалог со комбо поле"

#: kdialog.cpp:76
msgid "Menu dialog"
msgstr "Дијалог со мени "

#: kdialog.cpp:77
msgid "Check List dialog"
msgstr "Дијалог со листа со избори"

#: kdialog.cpp:78
msgid "Radio List dialog"
msgstr "Дијалог со листа со радио копчиња"

#: kdialog.cpp:79
msgid "Passive Popup"
msgstr "Пасивен дијалог"

#: kdialog.cpp:80
msgid "File dialog to open an existing file"
msgstr "Дијалог за отворање на постоечка датотека"

#: kdialog.cpp:81
msgid "File dialog to save a file"
msgstr "Дијалог за зачувување на датотека"

#: kdialog.cpp:82
msgid "File dialog to select an existing directory"
msgstr "Дијалог за избирање на постоечки именик"

#: kdialog.cpp:83
msgid "File dialog to open an existing URL"
msgstr "Дијалог за отворање на постоечки URL"

#: kdialog.cpp:84
msgid "File dialog to save a URL"
msgstr "Дијалог за зачувување на URL"

#: kdialog.cpp:85
msgid "Icon chooser dialog"
msgstr "Дијалог за избор на икони"

#: kdialog.cpp:86
msgid "Progress bar dialog, returns a DCOP reference for communication"
msgstr "Дијалог со лента за напредување, враќе DCOP референца за комуникација"

#: kdialog.cpp:90
msgid "Dialog title"
msgstr "Наслов на дијалогот"

#: kdialog.cpp:91
msgid "Default entry to use for combobox and menu"
msgstr "Стандарден внес за користење со комбо поле и менија"

#: kdialog.cpp:92
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple files"
msgstr ""
"Дозволува опциите --getopenurl и --getopenfilename да вратат повеќе датотеки"

#: kdialog.cpp:93
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr ""
"Ги враќа елементите од листата на посебни линии (за опцијата за изборна листа и "
"за отворање на датотеки со --multiple)"

#: kdialog.cpp:94
msgid "Outputs the winId of each dialog"
msgstr "Го печати winId на секој дијалог"

#: kdialog.cpp:95
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Го прави дијалогот транзиентен за X апликација зададена со winid"

#: kdialog.cpp:96
msgid ""
"Config file and option name for saving the \"dont-show/ask-again\" state"
msgstr ""
"Датотека за конфиг. и име на опција за зачувување на состојбата „не  "
"покажувај/прашај пак“"

#: kdialog.cpp:98
msgid "Arguments - depending on main option"
msgstr "Аргументи - во зависност од главната опција"

#: kdialog.cpp:666
msgid "KDialog"
msgstr "KDialog"

#: kdialog.cpp:667
msgid "KDialog can be used to show nice dialog boxes from shell scripts"
msgstr ""
"KDialog може да се користи за прикажување на убави дијалози од скрипти на "
"школката"

#: kdialog.cpp:670
msgid "Current maintainer"
msgstr "Моментален одржувач"

