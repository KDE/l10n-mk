#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgid "Name=Embedded Text Editor"
msgstr "Name=Вгнезден текст уредувач"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:72
msgid ""
"Comment=The text editor service provides applications with a text viewer and "
"editor. KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Comment=Сервисот за текст уредувач ги снабдува апликациите со текст прегледник "
"и уредувач. KDE апликациите што овозможуваат уредување текст би требало да го "
"користат овој сервис."

#: interfaces/ktexteditor/ktexteditor.desktop:6
