#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - Отвора оддалечени датотеки, набљудува евентуални промени, прашува за "
"качување"

#: main.cpp:54
#, fuzzy
msgid "Treat URLs as local files and delete them afterwards"
msgstr "Ги третира URL како локални датотеки и ги брише отпосле"

#: main.cpp:55
msgid "Command to execute"
msgstr "Команда за извршување"

#: main.cpp:56
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL или локална датотека за „команда“."

#: main.cpp:72
msgid ""
"'command' expected.\n"
msgstr ""
"Се очекуваше „команда“.\n"

#: main.cpp:97
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"УРЛ %1\n"
"е неправилен"

#: main.cpp:99
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Оддалечениот URL %1\n"
"не е дозволен со опцијата --tempfiles"

#: main.cpp:226
#, fuzzy
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Привремената датотека\n"
"%1\n"
"беше изменета.\n"
"Дали сеуште сакате да ја избришете?"

#: main.cpp:227 main.cpp:234
msgid "File Changed"
msgstr "Датотеката е променета"

#: main.cpp:227
msgid "Do Not Delete"
msgstr ""

