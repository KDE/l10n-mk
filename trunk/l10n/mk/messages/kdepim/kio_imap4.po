#: imap4.cc:624
msgid "Message from %1 while processing '%2': %3"
msgstr ""

#: imap4.cc:626
msgid "Message from %1: %2"
msgstr ""

#: imap4.cc:962
msgid "What do you want to store in this folder?"
msgstr "Што сакате да чувате во оваа папка?"

#: imap4.cc:962
msgid "Create Folder"
msgstr "Создади папка"

#: imap4.cc:963
msgid "&Messages"
msgstr "&Пораки"

#: imap4.cc:963
msgid "&Subfolders"
msgstr "&Подпапки"

#: imap4.cc:1295
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "Отпишувањето од папката %1 не успеа. Серверот одговори: %2"

#: imap4.cc:1316
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "Запишувањето на папката %1 не успеа. Серверот одговори: %2"

#: imap4.cc:1366 imap4.cc:1378
msgid "Changing the flags of message %1 failed."
msgstr "Менувањето на знаменцата на пораката %1 не успеа."

#: imap4.cc:1418
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Поставувањето на Листата за контрола на пристап на папката %1 за корисникот %2 "
"не успеа. Серверот врати: %3"

#: imap4.cc:1437
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"Бришењето на Листата за контрола на пристап на папката %1 за корисникот %2 не "
"успеа. Серверот врати: %3"

#: imap4.cc:1454 imap4.cc:1481
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: %2"
msgstr ""
"Преземањето на Листата за контрола на пристап на папката %1 не успеа. Серверот "
"одговори: %2"

#: imap4.cc:1515
#, fuzzy
msgid "Searching of folder %1 failed. The server returned: %2"
msgstr "Запишувањето на папката %1 не успеа. Серверот одговори: %2"

#: imap4.cc:1553
#, fuzzy
msgid "Setting the annotation %1 on folder %2  failed. The server returned: %3"
msgstr ""
"Поставувањето на Листата за контрола на пристап на папката %1 за корисникот %2 "
"не успеа. Серверот врати: %3"

#: imap4.cc:1577
#, fuzzy
msgid ""
"Retrieving the annotation %1 on folder %2 failed. The server returned: %3"
msgstr ""
"Преземањето на Листата за контрола на пристап на папката %1 не успеа. Серверот "
"одговори: %2"

#: imap4.cc:1626 imap4.cc:1697
msgid "Unable to close mailbox."
msgstr "Не можам да го затворам сандачето."

#: imap4.cc:1727
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "Не можам да добијам информации за папката %1. Серверот одговори: %2"

#: imap4.cc:1894
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"Серверот %1 не поддржува ниту IMAP4 ниту IMAP4rev1.\n"
"Тој се идентификуваше себе си со: %2"

#: imap4.cc:1905
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"Овој сервер не поддржува TLS.\n"
"Исклучете ја оваа безбедносна можност за да се поврзете некриптирано."

#: imap4.cc:1930
msgid "Starting TLS failed."
msgstr "Стартувањето на TLS не успеа."

#: imap4.cc:1940
msgid "The authentication method %1 is not supported by the server."
msgstr "Методот за проверка за автентичност %1 не е поддржан од овој сервер."

#: imap4.cc:1955
msgid "Username and password for your IMAP account:"
msgstr "Корисничко име и лозинка за вашата IMAP-сметка:"

#: imap4.cc:1969
#, fuzzy
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server %1 replied:\n"
"%2"
msgstr ""
"Не може да се најавите. Најверојатно лозинката е погрешна.\n"
"Серверот одговори:\n"
"%1"

#: imap4.cc:1976
#, fuzzy
msgid ""
"Unable to authenticate via %1.\n"
"The server %2 replied:\n"
"%3"
msgstr ""
"Не може да се провери за автентичност преку %1.\n"
"Серверот одговори:\n"
"%2"

#: imap4.cc:1983
msgid "SASL authentication is not compiled into kio_imap4."
msgstr ""

#: imap4.cc:2512
msgid "Unable to open folder %1. The server replied: %2"
msgstr "Не можам да ја отворам папката %1. Серверот одговори: %2"

#~ msgid "In IMAP clear text login, only US-ASCII characters are possible. Please use a different authentication method that your server supports or try to get a different username."
#~ msgstr "Во текстуална најава на IMAP, возможни се само знаци од табелата US-ASCII. Користете друга метода за проверка за автентичност кој е поддржан од вашиот сервер или обидете се да добиете друго корисничко име."

#~ msgid "In IMAP clear text login, only US-ASCII characters are possible. Please use a different authentication method that your server supports or change your password."
#~ msgstr "Во текстуална најава на IMAP, возможни се само знаци од US-ASCII табелата. Користете друга метода за проверка за автентичност кој е поддржан од вашиот сервер или обидете се да ја смените вашата лозинка."
