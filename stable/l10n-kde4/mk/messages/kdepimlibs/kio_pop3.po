msgid "The server terminated the connection."
msgstr "Серверот ја прекина врската."

#: pop3.cpp:252
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"Невалиден одговор од серверот:\n"
"„%1“"

