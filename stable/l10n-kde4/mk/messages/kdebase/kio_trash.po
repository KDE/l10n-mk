#: ktrash.cpp:32
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:34
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Помошна програма за ракување со корпата за отпадоци на KDE\n"
"Забелешка: за да преместите датотеки во корпата, не го користете ktrash, "
"туку „kioclient move 'url' trash:/“"

#: ktrash.cpp:38
msgid "Empty the contents of the trash"
msgstr "Испразни ја содржината на корпата"

#: ktrash.cpp:40
msgid "Restore a trashed file to its original location"
msgstr "Обнови фрлена датотека на нејзината оригинална локација"

#: ktrash.cpp:42
msgid "Ignored"
msgstr "Игнорирано"

#: trashimpl.cpp:1070
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Корпата ја достигна максималната големина!\n"
"Исчистете ја рачно."

#: trashimpl.cpp:1081
msgid "The file is too large to be trashed."
msgstr ""
"Оваа датотека е премногу голема за да ја собере во корпата за отпадоци."

#: kcmtrash.cpp:119
msgid "Byte"
msgstr "Бајт"

#: kcmtrash.cpp:121
msgid "KByte"
msgstr "Килобајт"

#: kcmtrash.cpp:125
msgid "MByte"
msgstr "Мегабајт"

#: kcmtrash.cpp:129
msgid "GByte"
msgstr "Гигабајт"

#: kcmtrash.cpp:133
msgid "TByte"
msgstr "Терабајт"

#: kcmtrash.cpp:137
#, kde-format
msgid "(%1 %2)"
msgstr "(%1 %2)"

#: kcmtrash.cpp:266
msgid "Delete files older than:"
msgstr "Избриши ги датотеките постари од:"

#: kcmtrash.cpp:273 kcmtrash.cpp:317
msgid "day"
msgid_plural "days"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#: kcmtrash.cpp:279
msgid "Limit to maximum size"
msgstr "Ограничи на макс. големина"

#: kcmtrash.cpp:290
msgid "Maximum size:"
msgstr "Максимална големина:"

#: kcmtrash.cpp:303
msgid "When limit reached:"
msgstr "Кога ќе се достигне ограничувањето:"

#: kcmtrash.cpp:307
msgid "Warn Me"
msgstr "Предупреди ме"

#: kcmtrash.cpp:308
msgid "Delete Oldest Files From Trash"
msgstr "Избриши ги најстарите датотеки од корпата"

#: kcmtrash.cpp:309
msgid "Delete Biggest Files From Trash"
msgstr "Избриши ги најголемите датотеки од корпата"

#: kio_trash.cpp:91 kio_trash.cpp:154 kio_trash.cpp:303 kio_trash.cpp:335
#: kio_trash.cpp:501 kio_trash.cpp:513
#, kde-format
msgid "Malformed URL %1"
msgstr "Неправилен URL %1"

#: kio_trash.cpp:110
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Именикот %1 не постои повеќе, и поради тоа не е можно оваа ставка да се "
"обнови на нејзината оригинална локација. Можете или да го создадете именикот "
"повторно и повторно да ја активирате операцијата за обновување, или да ја "
"одвлечете ставката на друго место за да ја обновите."

#: kio_trash.cpp:139
msgid "This file is already in the trash bin."
msgstr "Оваа датотека е веќе во корпата за отпадоци."
