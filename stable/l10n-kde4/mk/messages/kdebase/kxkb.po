#. i18n: file: kcmlayoutwidget.ui:461
#. i18n: ectx: property (whatsThis), widget (QPushButton, btnXkbShortcut)
#: rc.cpp:107
msgid ""
"This is a shortcut for switching layouts which is handled by X.org. It "
"allows modifier-only shortcuts."
msgstr ""
"Ова е кратенка за менување распореди со која ракува X.org. Таа дозволува "
"кратенки само со модификатори."

#. i18n: file: kcmlayoutwidget.ui:478
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:116
