#, kde-format
msgid "Error: %1"
msgstr "Грешка: %1"

#: solid-hardware.cpp:442
#, kde-format
msgid "Progress: %1%"
msgstr "Напредок: %1%"

#: solid-hardware.cpp:448
#, kde-format
msgid "Info: %1"
msgstr "Инфо: %1"
