#: kcmtrash.cpp:158 kcmtrash.cpp:256
msgid " day"
msgid_plural " days"
msgstr[0] " ден"
msgstr[1] " дена"
msgstr[2] " дена"

#: kcmtrash.cpp:247
msgid "Delete files older than:"
msgstr "Избриши ги датотеките постари од:"

#: kcmtrash.cpp:266
msgid "Limit to maximum size"
msgstr "Ограничи на макс. големина"

#: kcmtrash.cpp:294
msgid "Maximum size:"
msgstr "Максимална големина:"

#: kcmtrash.cpp:296
msgid "When limit reached:"
msgstr "Кога ќе се достигне ограничувањето:"

#: kcmtrash.cpp:300
msgid "Warn Me"
msgstr "Предупреди ме"

#: kcmtrash.cpp:301
msgid "Delete Oldest Files From Trash"
msgstr "Избриши ги најстарите датотеки од корпата"

#: kcmtrash.cpp:302
msgid "Delete Biggest Files From Trash"
msgstr "Избриши ги најголемите датотеки од корпата"

#: kio_trash.cpp:93 kio_trash.cpp:159 kio_trash.cpp:315 kio_trash.cpp:347
#: kio_trash.cpp:513 kio_trash.cpp:525
#, kde-format
msgid "Malformed URL %1"
msgstr "Неправилен URL %1"

#: kio_trash.cpp:115
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Именикот %1 не постои повеќе, и поради тоа не е можно оваа ставка да се "
"обнови на нејзината оригинална локација. Можете или да го создадете именикот "
"повторно и повторно да ја активирате операцијата за обновување, или да ја "
"одвлечете ставката на друго место за да ја обновите."

#: kio_trash.cpp:144 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Оваа датотека е веќе во корпата за отпадоци."

#: kio_trash.cpp:233 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Внатрешна грешка во copyOrMove, не смее да се случи"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "не е поддржано"

#: ktrash.cpp:41
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Помошна програма за ракување со корпата за отпадоци на KDE\n"
"Забелешка: за да преместите датотеки во корпата, не го користете ktrash, "
"туку „kioclient move 'url' trash:/“"

#: ktrash.cpp:44
msgid "Empty the contents of the trash"
msgstr "Испразни ја содржината на корпата"

#: ktrash.cpp:45
msgid "Restore a trashed file to its original location"
msgstr "Обнови фрлена датотека на нејзината оригинална локација"

#: trashimpl.cpp:1123
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Корпата ја достигна максималната големина!\n"
"Исчистете ја рачно."

#: trashimpl.cpp:1134
msgid "The file is too large to be trashed."
msgstr ""
"Оваа датотека е премногу голема за да ја собере во корпата за отпадоци."

#~ msgid "ktrash"
#~ msgstr "ktrash"

#~ msgid "Ignored"
#~ msgstr "Игнорирано"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>Check this box to allow <b>automatic deletion</b> of files that are "
#~ "older than the value specified. Leave this disabled to <b>not</b> "
#~ "automatically delete any items after a certain timespan</para>"
#~ msgstr ""
#~ "<para>Обележете го ова поле за да овозможите <b>автоматско бришење</b> на "
#~ "датотеки што се постари од наведената вредност. Оставете необележано за "
#~ "датотеките да <b>не</b> се бришат автоматски по изминатото време.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>Set the number of days that files can remain in the trash. Any "
#~ "files older than this will be automatically deleted.</para>"
#~ msgstr ""
#~ "<para>Поставете колку дена датотеките може да останат во корпата. Сите "
#~ "датотеки постари од ова ќе бидат автоматски избришани.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>Check this box to limit the trash to the maximum amount of disk "
#~ "space that you specify below. Otherwise, it will be unlimited.</para>"
#~ msgstr ""
#~ "<para>Обележете го ова поле за да ја ограничите корпата на максималното "
#~ "количество дисков простор што ќе го наведете долу. Инаку, ќе биде "
#~ "неограничена.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>This is the maximum percent of disk space that will be used for the "
#~ "trash.</para>"
#~ msgstr ""
#~ "<para>Ова е максималниот процент дисков простор што ќе се користи за "
#~ "корпата.</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>This is the calculated amount of disk space that will be allowed "
#~ "for the trash, the maximum.</para>"
#~ msgstr ""
#~ "<para>Ова е пресметаното максимално количество дисков простор за корпата."
#~ "</para>"

#~ msgctxt "@info:whatsthis"
#~ msgid ""
#~ "<para>When the size limit is reached, it will prefer to delete the type "
#~ "of files that you specify, first. If this is set to warn you, it will do "
#~ "so instead of automatically deleting files.</para>"
#~ msgstr ""
#~ "<para>Кога е достигнато ограничувањето за големина, ќе претпочита да прво "
#~ "да ги избрише датотеките од типовите што сте ги задале. Ако е ова "
#~ "поставено да ве предупредува, ќе го направи тоа наместо автоматски да ги "
#~ "избрише датотеките.</para>"

