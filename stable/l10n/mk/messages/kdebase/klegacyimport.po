#: legacyimport.cpp:23
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes from "
"other platforms in your new KDE desktop. The most common type of legacy theme "
"is for the GTK toolkit, which is imported to KDE's Control Center with this "
"utility.<P>In order to do this you must specify at least one item: the folder "
"where the pixmaps for the theme is located. You may also have to specify the "
"theme's gtkrc file if it's not in the same folder as the pixmaps. Both are "
"usually in the folder \"gtk\" inside the theme's folder.</QT>"
msgstr ""
"<QT><b>Увозник на стари теми</b><P>KDE сега поддржува користење на стари теми "
"од други платформи на вашата нова KDE работна површина. Највообичаениот вид "
"стари теми се оние за библиотеката GTK, кои се внесуваат во Контролниот центар "
"на KDE со помош на оваа алатка.<P>За да го направите ова, мора да наведете "
"барем една работа: папката каде што се наоѓаат сликичките од темата. Исто така, "
"можеби ќе треба да ја наведете и датотеката gtkrc на темата, ако таа не е во "
"истата папка. Вообичаено двете се во папката „gtk“ во папката на темата.</QT>"

#: legacyimport.cpp:33
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Чекор 1: Наведете ја папката со сликички за темата:"

#: legacyimport.cpp:51
msgid "Specify pixmap Folder"
msgstr "Наведете ја папката со сликички"

#: legacyimport.cpp:55
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the specified "
"folder. If it exists somewhere other than where the pixmaps are located enter "
"it here.</QT>"
msgstr ""
"<QT><b>Увозник на стари теми</b><P>Не е најдена датотека gtkrc во наведената "
"папка. Ако таа постои на некое друго место, наведете го тоа тука.</QT>"

#: legacyimport.cpp:59
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Чекор 2: Наведете ја датотеката gtkrc на темата:"

#: legacyimport.cpp:76
msgid "Specify gtkrc Folder"
msgstr "Наведете ја папката gtkrc"

#: legacyimport.cpp:85
msgid "Legacy Import"
msgstr "Внес на стари теми"

#: legacyimport.cpp:92
msgid "GTK Themes Folder"
msgstr "Папка со GTK теми"

#: legacyimport.cpp:116 legacyimport.cpp:137
msgid "You did not enter a valid file!"
msgstr "Не внесовте валидна датотека!"

#: legacyimport.cpp:124
msgid "Gtkrc Theme File"
msgstr "Gtkrc датотека за тема"

#: legacyimport.cpp:143
msgid "Theme Title"
msgstr "Наслов на тема"

#: legacyimport.cpp:144
msgid "Please enter a short title for this theme:"
msgstr "Внесете краток наслов за оваа тема:"

#: legacyimport.cpp:151
msgid "Legacy widget theme"
msgstr "Тема со стари графички контроли"

#: legacyimport.cpp:157
msgid "The theme is now installed and will be shown in KDE's Control Center."
msgstr ""
"Темата е сега инсталирана и ќе биде прикажана во Контролниот центар на KDE."

#: legacyimport.cpp:164
msgid "KLegacyImport"
msgstr "KLegacyImport"

#: legacyimport.cpp:165
msgid "Importer for legacy themes"
msgstr "Увозник на стари теми"

