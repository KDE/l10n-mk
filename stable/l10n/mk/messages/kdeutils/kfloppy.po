#: main.cpp:47
msgid "KFloppy"
msgstr "KFloppy"

#: main.cpp:53
#, fuzzy
msgid "KFloppy helps you format floppies with the filesystem of your choice."
msgstr ""
"KFloppy ви помага да форматирате уреди со менливи носачи  (како што се дискети, "
"Zip-дискети,\n"
"или LS120-дискети) со датотечен систем по ваш избор."

#: main.cpp:56
#, fuzzy
msgid "Author and former maintainer"
msgstr "Автор, одржувач"

#: main.cpp:57
msgid "User interface re-design"
msgstr "Редизајн на корисничкиот интерфејс"

#: main.cpp:58
msgid "Add BSD support"
msgstr "Додадена поддршка за BSD"

#: main.cpp:59
#, fuzzy
msgid "Make KFloppy work again for KDE 3.4"
msgstr "Направи KFloppy пак да работи за KDE 3.4"

